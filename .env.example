# ---------------------------------------------------------------------------
# Lwkypedia — biến môi trường
# Sao chép file này thành .env.local rồi điền giá trị.
# ---------------------------------------------------------------------------

# Vercel Blob — read/write token của store "lowkeypedia-data"
# Lấy tại: Vercel Dashboard → Storage → lowkeypedia-data → .env.local
# Nếu bỏ trống, web vẫn chạy bằng dữ liệu seed kèm sẵn (chỉ đọc, không lưu được).
BLOB_READ_WRITE_TOKEN=

# Mật khẩu đăng nhập trang quản trị /admin
ADMIN_PASSWORD=

# Chuỗi bí mật dùng để ký cookie admin.
# Nên là chuỗi ngẫu nhiên ≥ 32 ký tự. Gợi ý tạo: `openssl rand -hex 32`
# Đổi giá trị này (hoặc ADMIN_PASSWORD) sẽ vô hiệu hoá mọi phiên đăng nhập cũ.
ADMIN_SECRET=

# URL công khai của site — dùng cho canonical, Open Graph, sitemap, robots.
# Đặt khi deploy. Mặc định: https://lwkypedia.vercel.app
NEXT_PUBLIC_SITE_URL=

# (Tuỳ chọn) Số lần thử đăng nhập sai tối đa trong 10 phút. Mặc định 8.
# E2E test đặt biến này để kiểm tra luồng giới hạn mà không khoá các test khác.
LOGIN_RATE_LIMIT_MAX=

# (Tuỳ chọn) Ghi đè tên thương hiệu hiển thị trên header/footer.
# NEXT_PUBLIC_SITE_NAME=LWKYPEDIA
# NEXT_PUBLIC_SITE_TAGLINE=Wiki Liên Quân Mobile Việt Nam
